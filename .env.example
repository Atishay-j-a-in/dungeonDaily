NODE_ENV=development
PORT=4000
# Frontend dev server port
WEB_PORT=5173
# Public API base URL used by the dummy frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000

MONGODB_URI=
MONGODB_DB_NAME=dungeonsdaily

# Gemma — open-weight AI core (Dungeon Master), via Vercel AI SDK.
# Google provider: key at https://aistudio.google.com (GOOGLE_GENERATIVE_AI_API_KEY).
# Server-side only — never expose to the frontend. Match GEMMA_MODEL to a
# Gemma id on ai.google.dev (e.g. gemma-4-26b-a4b-it).
GOOGLE_GENERATIVE_AI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# ElevenLabs — DM voice (TTS), one-shot SFX, and environment music.
# Prefer `pnpx -y @elevenlabs/cli@latest onboard init` which writes the key
# to root `.env.local` (gitignored). Server-side only — never expose to the frontend.
ELEVENLABS_API_KEY=
# Default DM voice: George (narrative). Override to pick another voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_SFX_MODEL_ID=eleven_text_to_sound_v2
ELEVENLABS_MUSIC_MODEL_ID=music_v2_5

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Browser error reports (public by design; traces/replay stay off).
VITE_SENTRY_DSN=
