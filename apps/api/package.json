{
  "name": "@dungeonsdaily/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @dungeonsdaily/shared build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "echo \"api: no lint configured\"",
    "ai:check": "tsx src/modules/ai/check.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@clerk/express": "^2.1.77",
    "@dungeonsdaily/shared": "workspace:*",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@sentry/node": "^11.5.0",
    "ai": "^7.0.133",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
